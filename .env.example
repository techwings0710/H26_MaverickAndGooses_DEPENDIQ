# Exact approved roots, separated by your OS path separator (: on macOS).
DEPENDIQ_APPROVED_ROOTS=/absolute/path/to/LinkWatch
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=gemma4:e2b
GEMMA_TIMEOUT=120
# Opt in only after inspecting the repository and building the offline image.
DEPENDIQ_ENABLE_EXECUTION=0
DEPENDIQ_VERIFY_IMAGE=dependiq-verifier:local
